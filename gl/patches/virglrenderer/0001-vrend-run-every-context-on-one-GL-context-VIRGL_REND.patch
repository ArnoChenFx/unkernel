From 360da089f824d9d8670803f0279a6eded3f70818 Mon Sep 17 00:00:00 2001
From: Pooya Parsa <pooya@pi0.io>
Date: Sat, 21 Nov 2026 13:55:13 +0000
Subject: [PATCH] vrend: run every context on one GL context
 (VIRGL_RENDERER_SINGLE_GL_CONTEXT)

For hosts without share groups (WebGL): every renderer context, sub
context and the GL blitter run on the GL context that
vrend_renderer_init creates, and the renderer re-emits GL state when it
switches between sub contexts (vrend_single_acquire); queries open across
a switch are split and their parts added up. vtest: --single-gl-context
or VTEST_SINGLE_GL_CONTEXT. GLES hosts only; the sync thread is ignored.
---
 src/virglrenderer.c        |   2 +
 src/virglrenderer.h        |   7 +
 src/vrend/vrend_blitter.c  |  28 ++-
 src/vrend/vrend_renderer.c | 425 +++++++++++++++++++++++++++++++++++--
 src/vrend/vrend_renderer.h |   5 +
 vtest/vtest_server.c       |  11 +
 6 files changed, 459 insertions(+), 19 deletions(-)

diff --git a/src/virglrenderer.c b/src/virglrenderer.c
index 79717fc..6229da1 100644
--- a/src/virglrenderer.c
+++ b/src/virglrenderer.c
@@ -919,6 +919,8 @@ int virgl_renderer_init(void *cookie, int flags, struct virgl_renderer_callbacks
          renderer_flags |= VREND_USE_GLES;
       if (flags & VIRGL_RENDERER_VENUS)
          renderer_flags |= VREND_USE_GBM_LAYOUT;
+      if (flags & VIRGL_RENDERER_SINGLE_GL_CONTEXT)
+         renderer_flags |= VREND_USE_SINGLE_CONTEXT;
 
       ret = vrend_renderer_init(&vrend_cbs, renderer_flags);
       if (ret) {
diff --git a/src/virglrenderer.h b/src/virglrenderer.h
index 0bcafef..dc029d5 100644
--- a/src/virglrenderer.h
+++ b/src/virglrenderer.h
@@ -169,6 +169,13 @@ struct virgl_renderer_callbacks {
 /* Blob allocations must be done by guest from dedicated heap (Host visible memory). */
 #define VIRGL_RENDERER_USE_GUEST_VRAM (1 << 14)
 
+/*
+ * Run every virgl context on one GL context, for hosts without share groups
+ * (WebGL). The renderer re-emits GL state when it switches between contexts.
+ * Needs a GLES host; the sync thread (VIRGL_RENDERER_THREAD_SYNC) is ignored.
+ */
+#define VIRGL_RENDERER_SINGLE_GL_CONTEXT (1 << 15)
+
 VIRGL_EXPORT int virgl_renderer_init(void *cookie, int flags, struct virgl_renderer_callbacks *cb);
 VIRGL_EXPORT void virgl_renderer_poll(void); /* force fences */
 
diff --git a/src/vrend/vrend_blitter.c b/src/vrend/vrend_blitter.c
index f829115..cd20cd1 100644
--- a/src/vrend/vrend_blitter.c
+++ b/src/vrend/vrend_blitter.c
@@ -458,7 +458,14 @@ static void vrend_renderer_init_blit_ctx(struct vrend_blitter_ctx *blit_ctx)
    struct virgl_gl_ctx_param ctx_params;
    int i;
    if (blit_ctx->initialised) {
-      vrend_sync_make_current(blit_ctx->gl_context);
+      if (vrend_renderer_single_gl_context()) {
+         /* The blitter shares the one GL context: leave the client's state
+          * and set up what the blitter's own context would hold. */
+         vrend_renderer_single_enter_blitter();
+         glBindVertexArray(blit_ctx->vaoid);
+         glBindBuffer(GL_ARRAY_BUFFER, blit_ctx->vbo_id);
+      } else
+         vrend_sync_make_current(blit_ctx->gl_context);
       return;
    }
 
@@ -467,7 +474,10 @@ static void vrend_renderer_init_blit_ctx(struct vrend_blitter_ctx *blit_ctx)
    blit_ctx->use_gles = epoxy_is_desktop_gl() == 0;
    ctx_params.shared = true;
    ctx_params.compat_ctx = false;
-   for (uint32_t i = 0; i < ARRAY_SIZE(gl_versions); i++) {
+   blit_ctx->gl_context = vrend_renderer_single_gl_context();
+   if (blit_ctx->gl_context)
+      vrend_renderer_single_enter_blitter();
+   for (uint32_t i = 0; !blit_ctx->gl_context && i < ARRAY_SIZE(gl_versions); i++) {
       ctx_params.major_ver = gl_versions[i].major;
       ctx_params.minor_ver = gl_versions[i].minor;
 
@@ -481,7 +491,8 @@ static void vrend_renderer_init_blit_ctx(struct vrend_blitter_ctx *blit_ctx)
       abort();
    }
 
-   vrend_sync_make_current(blit_ctx->gl_context);
+   if (!vrend_renderer_single_gl_context())
+      vrend_sync_make_current(blit_ctx->gl_context);
    glGenVertexArrays(1, &blit_ctx->vaoid);
    glGenFramebuffers(1, &blit_ctx->fb_id);
 
@@ -916,7 +927,16 @@ void vrend_blitter_fini(void)
    vrend_blit_ctx.initialised = false;
    if (vrend_blit_ctx.blit_programs)
       _mesa_hash_table_u64_destroy(vrend_blit_ctx.blit_programs, delete_program_cb);
-   vrend_clicbs->destroy_gl_context(vrend_blit_ctx.gl_context);
+   if (vrend_renderer_single_gl_context()) {
+      /* the GL context outlives the blitter: free what its own would have */
+      if (vrend_blit_ctx.gl_context) {
+         glDeleteVertexArrays(1, &vrend_blit_ctx.vaoid);
+         glDeleteFramebuffers(1, &vrend_blit_ctx.fb_id);
+         glDeleteBuffers(1, &vrend_blit_ctx.vbo_id);
+         glDeleteShader(vrend_blit_ctx.vs);
+      }
+   } else
+      vrend_clicbs->destroy_gl_context(vrend_blit_ctx.gl_context);
    memset(&vrend_blit_ctx, 0, sizeof(vrend_blit_ctx));
 }
 
