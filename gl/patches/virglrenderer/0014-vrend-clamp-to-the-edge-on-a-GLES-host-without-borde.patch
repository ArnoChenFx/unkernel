From 771d0837fce350c82e2689385e82961ada22e1d5 Mon Sep 17 00:00:00 2001
From: Pooya Parsa <pooya@pi0.io>
Date: Sun, 22 Nov 2026 04:44:22 +0000
Subject: [PATCH] vrend: clamp to the edge on a GLES host without border clamp

A GLES host without border clamp (no GL_EXT_texture_border_clamp or
GL_OES_texture_border_clamp; WebGL2 has neither) refuses
GL_CLAMP_TO_BORDER as a wrap mode with GL_INVALID_ENUM, and the pending
error fails the context's next error check: the context is in error and
refuses every later command buffer. The guest's Mesa offers
OES_texture_border_clamp whatever the host can do, and GTK 4's GL
renderer (GskGLRenderer) samples with it from its first frame, so a GTK 4
window stayed blank.

Take GL_CLAMP_TO_EDGE there instead: only lookups outside the texture
differ, with the edge texel instead of the border colour.
---
 src/vrend/vrend_renderer.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/src/vrend/vrend_renderer.c b/src/vrend/vrend_renderer.c
index 892f3ea..fec16df 100644
--- a/src/vrend/vrend_renderer.c
+++ b/src/vrend/vrend_renderer.c
@@ -2551,7 +2551,17 @@ static GLuint convert_wrap(struct vrend_context *ctx, int wrap)
    case PIPE_TEX_WRAP_CLAMP: if (vrend_state.use_core_profile == false) return GL_CLAMP; else return GL_CLAMP_TO_EDGE;
 
    case PIPE_TEX_WRAP_CLAMP_TO_EDGE: return GL_CLAMP_TO_EDGE;
-   case PIPE_TEX_WRAP_CLAMP_TO_BORDER: return GL_CLAMP_TO_BORDER;
+   case PIPE_TEX_WRAP_CLAMP_TO_BORDER:
+      /* A GLES host without border clamp (WebGL2 has none) refuses
+       * GL_CLAMP_TO_BORDER, and the pending error then fails the context's
+       * next check, which ends the context. The guest's Mesa offers
+       * OES_texture_border_clamp whatever the host can do (GTK 4's GL
+       * renderer samples with it), so take the edge texel instead: only
+       * lookups outside the texture differ (the edge colour instead of the
+       * border colour). */
+      if (vrend_state.use_gles && !has_feature(feat_sampler_border_colors))
+         return GL_CLAMP_TO_EDGE;
+      return GL_CLAMP_TO_BORDER;
 
    case PIPE_TEX_WRAP_MIRROR_REPEAT: return GL_MIRRORED_REPEAT;
    case PIPE_TEX_WRAP_MIRROR_CLAMP:
