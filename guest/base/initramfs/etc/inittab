# /etc/inittab of the base shell (busybox init; /init starts it
# when there is no distro to boot): a root shell on the console, and kwtty
# for the host's terminal sessions over vsock.

::sysinit:/kw/lib/sysinit
hvc0::respawn:-/bin/sh
::respawn:/usr/bin/kwtty serve
::ctrlaltdel:/bin/reboot
::shutdown:/usr/lib/kw/shutdown
