# /etc/profile of the base shell.

export PATH=/usr/sbin:/usr/bin:/sbin:/bin
export HOME=/root
case $TERM in linux | vt102 | "") export TERM=xterm-256color ;; esac
[ "$PWD" = / ] && cd /root
PS1='\[\033[33m\]base\[\033[0m\] \w # '
