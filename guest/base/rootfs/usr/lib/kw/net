#!/run/kw-lower/bin/busybox sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026 Pooya Parsa <pooya@pi0.io>
# /usr/lib/kw/net (the kw layer): the network, with the base's busybox: lo,
# and eth0 by DHCP when the host provides kwnet (js/core/net.ts); the lease
# is applied by /usr/lib/kw/udhcpc.

PATH=/run/kw-lower/bin
ip link set lo up
[ -e /sys/class/net/eth0 ] || exit 0
ip link set eth0 up
udhcpc -i eth0 -s /usr/lib/kw/udhcpc -q -n -t 3 -T 1 >/dev/null 2>&1 || echo "kw-net: no DHCP lease on eth0"
exit 0
