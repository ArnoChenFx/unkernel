#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2026 Pooya Parsa <pooya@pi0.io>
#
# bwrap shim, installed as /usr/local/bin/bwrap, ahead of bubblewrap's
# /usr/bin/bwrap. A workaround: the kernel has no seccomp, so `bwrap
# --seccomp FD` fails, and with it every GTK program that loads an image
# (gdk-pixbuf runs its loaders through glycin under `bwrap --unshare-all ...
# --seccomp FD`; Xfce's panel and desktop abort on their first icon). This
# drops `--seccomp FD` and `--add-seccomp-fd FD` and runs the real bwrap with
# the rest, so the namespaces still apply and the syscall filter does not.
# Remove it once arch/wasm has seccomp.

real=/usr/bin/bwrap
[ -x "$real" ] || {
	echo "bwrap: bubblewrap is not installed (sudo apk add bubblewrap)" >&2
	exit 127
}
skip=
for a do
	shift
	if [ -n "$skip" ]; then
		skip=
		continue
	fi
	case $a in
	--seccomp | --add-seccomp-fd)
		skip=1
		continue
		;;
	esac
	set -- "$@" "$a"
done
exec "$real" "$@"
