# halt for every user: busybox's /sbin/halt signals init, which only root
# may: another user goes through sudo -n (the image's user has it without
# a password). It leaves its name in /run/kw-shutdown first, so that
# /usr/lib/kw/shutdown, which init runs, halts without busybox init's
# pauses.

# unkernel: halt for the image's user too.
[ "$(id -u)" = 0 ] || exec sudo -n /usr/local/sbin/halt "$@"
echo halt > /run/kw-shutdown
/sbin/halt "$@" || { r=$?; rm -f /run/kw-shutdown; exit $r; }
