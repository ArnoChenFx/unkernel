# halt for every user: busybox's /sbin/halt signals init, which only root
# may: another user goes through sudo -n (the image's user has it without
# a password).

# unkernel: halt for the image's user too.
[ "$(id -u)" = 0 ] && exec /sbin/halt "$@"
exec sudo -n /sbin/halt "$@"
