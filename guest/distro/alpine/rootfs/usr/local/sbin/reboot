# reboot for every user: busybox's /sbin/reboot signals init, which only root
# may: another user goes through sudo -n (the image's user has it without
# a password).

# unkernel: reboot for the image's user too.
[ "$(id -u)" = 0 ] && exec /sbin/reboot "$@"
exec sudo -n /sbin/reboot "$@"
