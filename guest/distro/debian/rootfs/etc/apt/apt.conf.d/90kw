// apt and debconf for a slow CPU and no one at the prompt: no recommends
// (the minimal set stays minimal), no index diffs (one download beats many
// patches), no pty per dpkg run. The image's docker-* files already keep
// indexes gzipped, skip translations and use force-unsafe-io.

// unkernel
APT::Install-Recommends "false";
Acquire::PDiffs "false";
Dpkg::Use-Pty "false";
