 static SDL_keysym *TranslateKey(int scancode, SDL_keysym *keysym);
 
+/*
+ * Without a virtual terminal (no VT_*, KDSKBMODE or KDSETMODE, as in the
+ * unkernel) the keyboard and mouse come from evdev devices
+ * (/dev/input/event*: real presses and releases) and from the terminal on
+ * stdin. Both are read until the first evdev key event; from then on the
+ * terminal is only drained, so a host that sends each key to both does not
+ * deliver it twice. Keys are reported with Linux key codes as scancodes and
+ * US-layout keysyms.
+ *
+ * A terminal sends characters and escape sequences, not releases: a key goes
+ * down at its byte and up NOVT_HOLD ms later (sooner when the next key needs
+ * other modifiers), and a repeated byte releases and presses it again.
+ * Shift, Ctrl and Alt are derived from the character or the sequence's
+ * modifier parameter. The terminal is raw while the video mode is set and is
+ * restored at exit or on a signal; Ctrl-C (ISIG) still ends the program.
+ */
+#include <linux/input.h>
+#include <signal.h>
+
+#define NOVT_HOLD	250
+#define NOVT_MAX_EVDEV	8
+#define NOVT_SHIFT	1
+#define NOVT_ALT	2
+#define NOVT_CTRL	4
+
+static int novt;			/* 1: keyboard_fd is stdin or /dev/null */
+static int novt_term = -1;		/* stdin, while it is in raw mode */
+static struct termios novt_saved;
+static int novt_evdev[NOVT_MAX_EVDEV];
+static int novt_nevdev;
+static int novt_evdev_keys;		/* an evdev key event was seen */
+static Uint32 novt_up_at[128];		/* release time per key code, 0 = up */
+static int novt_mods;			/* modifiers pressed for terminal keys */
+
+/* US layout: the character of key codes 0-53, unshifted and shifted. */
+static const char novt_lower[] = "\0\0" "1234567890-=" "\0\0" "qwertyuiop[]"
+	"\0\0" "asdfghjkl;'`" "\0" "\\zxcvbnm,./";
+static const char novt_upper[] = "\0\0" "!@#$%^&*()_+" "\0\0" "QWERTYUIOP{}"
+	"\0\0" "ASDFGHJKL:\"~" "\0" "|ZXCVBNM<>?";
+
+static void novt_term_restore(void)
+{
+	if ( novt_term >= 0 ) {
+		tcsetattr(novt_term, TCSAFLUSH, &novt_saved);
+		novt_term = -1;
+	}
+}
+
+static void novt_signal(int sig)
+{
+	novt_term_restore();
+	signal(sig, SIG_DFL);
+	raise(sig);
+}
+
+static void novt_term_raw(void)
+{
+	static int hooked;
+	struct termios t;
+
+	if ( novt_term >= 0 || !isatty(0) || tcgetattr(0, &novt_saved) < 0 ) {
+		return;
+	}
+	t = novt_saved;
+	t.c_lflag &= ~(ICANON | ECHO);
+	t.c_iflag &= ~(ISTRIP | IGNCR | ICRNL | INLCR | IXOFF | IXON);
+	t.c_cc[VMIN] = 0;
+	t.c_cc[VTIME] = 0;
+	if ( tcsetattr(0, TCSAFLUSH, &t) < 0 ) {
+		return;
+	}
+	novt_term = 0;
+	if ( !hooked ) {
+		hooked = 1;
+		atexit(novt_term_restore);
+		signal(SIGINT, novt_signal);
+		signal(SIGTERM, novt_signal);
+		signal(SIGHUP, novt_signal);
+		signal(SIGQUIT, novt_signal);
+	}
+}
+
+static void novt_open_evdev(void)
+{
+	DIR *dir = opendir("/dev/input");
+	struct dirent *de;
+	unsigned long bits[KEY_MAX / (8 * sizeof(long)) + 1];
+	char path[300];
+	int fd, keyboard, mouse;
+
+	if ( !dir ) {
+		return;
+	}
+	while ( (de = readdir(dir)) != NULL && novt_nevdev < NOVT_MAX_EVDEV ) {
+		if ( SDL_strncmp(de->d_name, "event", 5) != 0 ) {
+			continue;
+		}
+		SDL_snprintf(path, sizeof(path), "/dev/input/%s", de->d_name);
+		fd = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+		if ( fd < 0 ) {
+			continue;
+		}
+		SDL_memset(bits, 0, sizeof(bits));
+		ioctl(fd, EVIOCGBIT(EV_KEY, sizeof(bits)), bits);
+#define NOVT_BIT(b)	((bits[(b) / (8 * sizeof(long))] >> ((b) % (8 * sizeof(long)))) & 1)
+		keyboard = NOVT_BIT(KEY_A);
+		mouse = NOVT_BIT(BTN_LEFT);
+#undef NOVT_BIT
+		if ( keyboard || mouse ) {
+			novt_evdev[novt_nevdev++] = fd;
+		} else {
+			close(fd);
+		}
+	}
+	closedir(dir);
+}
+
