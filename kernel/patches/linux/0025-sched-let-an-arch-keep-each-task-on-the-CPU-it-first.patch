From 6f129fdfa89d287b0ea6334cd1347d3369df928d Mon Sep 17 00:00:00 2001
From: kernel-wasm <kernel-wasm@localhost>
Date: Mon, 16 Nov 2026 16:06:57 +0000
Subject: [PATCH] sched: let an arch keep each task on the CPU it first ran on

On wasm a task's stack lives in the host thread of the CPU that first
ran it, which alone can resume it. ARCH_TASKS_STAY_ON_CPU says that
the arch makes every task migration-disabled from its first run and
never re-enables migration; the scheduler already keeps such tasks on
their CPU everywhere.

An affinity change that excludes that CPU would then install a
pending migration and wait for a migrate_enable() that never comes.
Fail it with EBUSY instead.
---
 init/Kconfig        | 14 ++++++++++++++
 kernel/sched/core.c |  7 +++++++
 2 files changed, 21 insertions(+)

diff --git a/init/Kconfig b/init/Kconfig
index ad592fdf29a..e661747c367 100644
--- a/init/Kconfig
+++ b/init/Kconfig
@@ -974,6 +974,20 @@ config ARCH_SUPPORTS_NUMA_BALANCING
 # written after the unmap. Details are in mm/rmap.c near the check for
 # should_defer_flush. The architecture should also consider if the full flush
 # and the refill costs are offset by the savings of sending fewer IPIs.
+#
+# For architectures whose tasks cannot move to another CPU once they have
+# run (wasm: a task's stack lives in the host thread of the CPU that first
+# ran it). The arch keeps every task migration-disabled from its first run
+# on; an affinity change that excludes that CPU then fails with EBUSY
+# instead of waiting for a migrate_enable() that never comes. A new
+# kthread first runs only to report that it exists, and may be bound to
+# another CPU before it is woken: while it waits for that wakeup (and in a
+# park before its function) the arch may drop its stack and start it again
+# on a fresh one (arch_kthread_restart_point(), linux/kthread.h).
+#
+config ARCH_TASKS_STAY_ON_CPU
+	bool
+
 config ARCH_WANT_BATCHED_UNMAP_TLB_FLUSH
 	bool
 
diff --git a/kernel/sched/core.c b/kernel/sched/core.c
index 1754d9f95f2..5ce8a65223f 100644
--- a/kernel/sched/core.c
+++ b/kernel/sched/core.c
@@ -3166,6 +3166,13 @@ static int __set_cpus_allowed_ptr_locked(struct task_struct *p,
 			goto out;
 		}
 
+		if (IS_ENABLED(CONFIG_ARCH_TASKS_STAY_ON_CPU) &&
+		    is_migration_disabled(p) &&
+		    !cpumask_test_cpu(task_cpu(p), ctx->new_mask)) {
+			ret = -EBUSY;
+			goto out;
+		}
+
 		if (WARN_ON_ONCE(p == current &&
 				 is_migration_disabled(p) &&
 				 !cpumask_test_cpu(task_cpu(p), ctx->new_mask))) {
-- 
2.56.0

