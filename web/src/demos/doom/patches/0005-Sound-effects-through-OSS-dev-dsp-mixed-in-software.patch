diff --git a/fbdoom/i_sound_oss.c b/fbdoom/i_sound_oss.c
new file mode 100644
index 0000000..5515913
--- /dev/null
+++ b/fbdoom/i_sound_oss.c
@@ -0,0 +1,282 @@
